{
    "$schema": "./provider-templates.schema.json",
    "templates": [
        {
            "key": "twitch",
            "name": "Twitch",
            "slug": "twitch",
            "issuer": "https://id.twitch.tv/oauth2",
            "scopes": "openid user:read:email",
            "extra_authorize_params": "{\"claims\":\"{\\\"id_token\\\":{\\\"email\\\":null,\\\"email_verified\\\":null}}\"}",
            "button_color": "#9146FF",
            "icon": "fa-brands fa-twitch",
            "console_url": "https://dev.twitch.tv/console/apps"
        },
        {
            "key": "google",
            "name": "Google",
            "slug": "google",
            "issuer": "https://accounts.google.com",
            "scopes": "openid email profile",
            "button_color": "#4285F4",
            "icon": "fa-brands fa-google",
            "console_url": "https://console.cloud.google.com/apis/credentials"
        },
        {
            "key": "authentik",
            "name": "Authentik",
            "slug": "authentik",
            "issuer": "https://<YOUR_DOMAIN>/application/o/<SLUG>/",
            "scopes": "openid email profile",
            "button_color": "#FD4B2D",
            "icon": "fa fa-unlock-keyhole"
        },
        {
            "key": "discord",
            "name": "Discord",
            "slug": "discord",
            "issuer": "https://discord.com",
            "scopes": "openid identify email",
            "button_color": "#5865F2",
            "icon": "fa-brands fa-discord",
            "console_url": "https://discord.com/developers/applications"
        }
    ]
}
